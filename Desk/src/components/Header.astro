---
import HeaderLink from './HeaderLink.astro';
import { SITE_TITLE } from '../consts';

const tabs = [
	{ label: 'ホーム', href: '/' },
	{ label: 'セットアップ診断', href: '/category/workstyle-setup' },
	{ label: '記事一覧', href: '/blog' },
	{ label: '当サイトについて', href: '/about-us' },
];
const categories = [
	{ label: '機能的人間工学', href: '/category/functional-ergonomics' },
	{ label: '色彩理論と素材感', href: '/category/color-theory-and-materiality' },
	{ label: '配線管理の美学', href: '/category/cable-management' },
	{ label: '照明とサーカディアンリズム', href: '/category/lighting-design' },
	{ label: 'デジタル・ミニマリズム', href: '/category/digital-minimalism' },
	{ label: 'バイオフィリックデザイン', href: '/category/biophilic-design' },
	{ label: '集中とフローの心理学', href: '/category/psychology-of-flow' },
];
---

<header class="spec-header">
	<div class="spec-row spec-row-top">
		<a href="/" class="spec-tag spec-logo">
			<img src="/media-images/Logo.webp" alt="Minimal Desk Studio Logo" class="site-logo" onerror="this.style.display='none';"/>
			<span>Minimal Desk Studio</span>
		</a>
		<span class="spec-tag spec-meta">ミニマリスト・デスクセットアップの究極ガイド</span>
		<button type="button" class="spec-tag spec-cat-toggle" id="cat-toggle" aria-expanded="false" aria-controls="cat-row">カテゴリー一覧 +</button>
		<button type="button" class="nav-toggle" id="nav-toggle" aria-expanded="false" aria-controls="tab-row" aria-label="メニューを開く">
			<span></span><span></span><span></span>
		</button>
	</div>

	<nav class="spec-row spec-row-tabs" id="tab-row">
		{tabs.map((t) => <HeaderLink href={t.href}>{t.label}</HeaderLink>)}
		<a href="mailto:eugeneyu@maxora.ai" class="tab-contact">お問い合わせ</a>
	</nav>

	<div class="spec-row spec-row-categories" id="cat-row" hidden>
		{categories.map((c) => <a href={c.href} class="cat-cell">{c.label}</a>)}
	</div>
</header>

<script>
	const catToggle = document.getElementById('cat-toggle');
	const catRow = document.getElementById('cat-row');
	catToggle?.addEventListener('click', () => {
		const isHidden = catRow.hidden;
		catRow.hidden = !isHidden;
		catToggle.setAttribute('aria-expanded', isHidden ? 'true' : 'false');
		catToggle.textContent = isHidden ? 'カテゴリー一覧 −' : 'カテゴリー一覧 +';
	});

	const navToggle = document.getElementById('nav-toggle');
	const tabRow = document.getElementById('tab-row');
	navToggle?.addEventListener('click', () => {
		const isOpen = tabRow.classList.toggle('is-open');
		navToggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
	});
</script>

<style>
	.spec-header {
		font-family: 'IBM Plex Sans JP', sans-serif;
		background: #ffffff;
		border-bottom: 1px solid rgba(51,46,42,0.15);
		margin-bottom: 2em;
	}
	.spec-row {
		display: flex;
		align-items: stretch;
		flex-wrap: wrap;
		max-width: 1400px;
		margin: 0 auto;
	}
	.spec-row[hidden] {
		display: none;
	}
	.spec-row-top {
		border-bottom: 1px solid rgba(51,46,42,0.12);
	}
	.spec-tag {
		display: flex;
		align-items: center;
		gap: 0.6em;
		padding: 0.9em 1.4em;
		border-right: 1px solid rgba(51,46,42,0.12);
		text-decoration: none;
		color: #33302C;
		font-size: 0.9em;
		white-space: nowrap;
	}
	.spec-logo {
		font-family: 'Shippori Mincho', serif;
		font-weight: 700;
		font-size: 1.15em;
		color: var(--accent-dark, #6B4226);
	}
	.site-logo {
		height: 28px;
		width: 28px;
		object-fit: cover;
		border-radius: 2px;
	}
	.spec-meta {
		flex: 1;
		color: #8a8077;
		font-size: 0.82em;
		min-width: 200px;
	}
	.spec-cat-toggle {
		background: none;
		border: none;
		border-right: 1px solid rgba(51,46,42,0.12);
		cursor: pointer;
		font-family: inherit;
	}
	.spec-cat-toggle[aria-expanded="true"] {
		color: var(--accent, #C17F59);
	}
	.nav-toggle {
		display: none;
		background: none;
		border: none;
		width: 52px;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 4px;
		cursor: pointer;
	}
	.nav-toggle span {
		width: 18px;
		height: 1.5px;
		background: #33302C;
	}

	.spec-row-tabs {
		border-bottom: 1px solid rgba(51,46,42,0.12);
	}
	.spec-row-tabs :global(a) {
		padding: 0.8em 1.4em;
		border-right: 1px solid rgba(51,46,42,0.1);
		text-decoration: none;
		color: #33302C;
		font-size: 0.9em;
		transition: background-color 0.2s ease, color 0.2s ease;
	}
	.spec-row-tabs :global(a:hover), .spec-row-tabs :global(a.active) {
		background: #F7F4EF;
		color: var(--accent-dark, #6B4226);
	}
	.tab-contact {
		margin-left: auto;
		background: var(--accent, #C17F59);
		color: #fff !important;
	}
	.tab-contact:hover {
		background: var(--accent-dark, #6B4226) !important;
		color: #fff !important;
	}

	.spec-row-categories {
		flex-wrap: wrap;
	}
	.cat-cell {
		flex: 1 1 auto;
		min-width: 160px;
		padding: 0.7em 1.2em;
		border-right: 1px solid rgba(51,46,42,0.1);
		border-bottom: 1px solid rgba(51,46,42,0.1);
		text-decoration: none;
		color: #33302C;
		font-size: 0.85em;
		transition: background-color 0.2s ease;
	}
	.cat-cell:hover {
		background: #F7F4EF;
		color: var(--accent-dark, #6B4226);
	}

	@media (max-width: 860px) {
		.spec-meta {
			display: none;
		}
		.nav-toggle {
			display: flex;
		}
		.spec-row-tabs {
			display: none;
			flex-direction: column;
		}
		.spec-row-tabs.is-open {
			display: flex;
		}
		.tab-contact {
			margin-left: 0;
		}
	}
</style>
