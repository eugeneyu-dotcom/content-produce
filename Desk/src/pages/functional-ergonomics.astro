---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';

const title = `機能的人間工学 (Functional Ergonomics) | ${SITE_TITLE}`;
const description = "デスクワークの人間工学ピラー。椅子・姿勢・デスク高さ・キーボード・昇降デスク・モニター配置を科学的に整理し、疲れない環境の全体像を示します。";

const clusters = [
  { href: '/blog/chair-selection-back-pain/', tag: '椅子と腰痛', text: '「座る」の進化論。腰痛を未然に防ぐ、在宅ワーク用椅子の選び方。' },
  { href: '/blog/zaikin-desk-takasa-keisan/', tag: 'デスク高さ', text: '身長から逆算する、職人技の精度のデスク高さ計算法。' },
  { href: '/blog/desk-posture-correction-guide/', tag: '姿勢矯正', text: '人間工学の真髄。姿勢矯正グッズの科学的選定と生産性の最大化。' },
  { href: '/blog/ergonomics-keyboard-merit-guide/', tag: 'キーボード', text: 'エルゴノミクスキーボードの真価。手首の悲鳴を沈黙させる科学と美学。' },
  { href: '/blog/standing-desk-fatigue-solutions-japan/', tag: '昇降デスク', text: 'スタンディングデスクで「疲れる」を解消する実践的アプローチ。' },
  { href: '/blog/monitor-light-reflection-ergonomics/', tag: 'モニター視環境', text: '反射対策とエルゴノミクス。視覚快適性を高めるモニターの整え方。' },
];
---

<!doctype html>
<html lang="ja">
	<head>
		<BaseHead title={title} description={description} />
		<link href="https://fonts.googleapis.com/css2?family=Shippori+Mincho:wght@500;700&family=IBM+Plex+Sans+JP:wght@300;400;500&display=swap" rel="stylesheet">
		<style>
			body { font-family: 'IBM Plex Sans JP', -apple-system, 'Hiragino Kaku Gothic ProN', Meiryo, sans-serif; background-color: var(--bg-color, #F7F4EF); color: #33302C; margin: 0; }
			.hero { text-align: center; padding: 6.5em 1em; background: linear-gradient(135deg, #6B4226 0%, #a9744e 100%); width: 100vw; margin-left: calc(-50vw + 50%); }
			.hero .eyebrow { text-transform: uppercase; letter-spacing: 3px; font-size: 0.8em; color: #f0d9c7; margin-bottom: 1.2em; }
			.hero h1 { font-family: 'Shippori Mincho', serif; font-size: 2.8em; font-weight: 700; color: #fff; margin: 0 0 0.3em; line-height: 1.25; }
			.hero p { font-size: 1.15em; color: #f6e7db; max-width: 620px; margin: 0 auto; }
			.wrap { max-width: 940px; margin: 4em auto; padding: 0 20px; line-height: 1.9; }
			.wrap h2 { font-family: 'Shippori Mincho', serif; font-size: 1.9em; color: var(--accent-dark, #6B4226); border-bottom: 2px solid var(--accent, #C17F59); display: inline-block; padding-bottom: 8px; margin: 2em 0 0.8em; }
			.wrap p { font-size: 1.08em; color: #33302C; margin-bottom: 1.4em; }
			.cluster-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1.5em; margin: 2.5em 0; }
			.cluster-card { display: block; background: #FBFAF7; padding: 1.7em; border: 1px solid rgba(51,46,42,0.12); border-radius: 2px; text-decoration: none; transition: transform 0.2s, box-shadow 0.2s; }
			.cluster-card:hover { transform: translateY(-4px); box-shadow: 0 14px 34px rgba(107,66,38,0.12); }
			.cluster-card .tag { font-family: 'Shippori Mincho', serif; font-size: 1.25em; color: var(--accent-dark, #6B4226); margin-bottom: 0.4em; }
			.cluster-card .txt { color: #5C5650; font-size: 0.98em; }
			.faq-container { margin-top: 4em; border-top: 1px solid rgba(51,46,42,0.12); padding-top: 3em; }
			.faq-item { background: #FBFAF7; padding: 1.4em 1.6em; border-radius: 2px; margin-bottom: 1.1em; border-left: 4px solid var(--accent, #C17F59); }
			.faq-item h4 { margin: 0 0 0.4em; font-family: 'Shippori Mincho', serif; font-size: 1.15em; color: var(--accent-dark, #6B4226); }
			.faq-item p { margin: 0; font-size: 1em; color: #5C5650; }
			.cta-row { text-align: center; margin-top: 3em; }
			.cta-btn { display: inline-block; margin: 0.4em; padding: 13px 32px; border: 2px solid var(--accent-dark, #6B4226); color: var(--accent-dark, #6B4226); letter-spacing: 1px; font-weight: 600; text-decoration: none; border-radius: 2px; transition: 0.3s; }
			.cta-btn:hover { background: var(--accent-dark, #6B4226); color: #fff !important; }
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<p class="eyebrow">Pillar · Functional Ergonomics</p>
				<h1>機能的人間工学</h1>
				<p>疲れないデスクは、才能ではなく設計で決まる。</p>
			</section>

			<div class="wrap">
				<p>長時間のデスクワークで消耗するのは、意志力ではなく身体です。そして身体の負担の大半は、椅子・デスク高さ・視線・手首という数点の「寸法」で決まります。この人間工学のピラーは、感覚や根性ではなく、測れる要素から快適な環境を組み立てるための入口です。</p>
				<p>個々のアイテム選びに入る前に、まず全体像を押さえておきましょう。下のカードは、それぞれが独立した詳細ガイドへの入口です。</p>

				<h2>疲れを設計する六つの寸法</h2>
				<div class="cluster-grid">
					{clusters.map((c) => (
						<a class="cluster-card" href={c.href}>
							<div class="tag">{c.tag}</div>
							<div class="txt">{c.text}</div>
						</a>
					))}
				</div>

				<h2>優先順位のつけ方</h2>
				<p>すべてを一度に揃える必要はありません。効果と費用のバランスで見ると、着手すべき順番はおおむね決まっています。まず椅子とデスク高さ——ここが合っていないと、他に何を足しても土台が崩れます。次に視線の高さ、つまりモニターの位置。ノートパソコンをそのまま覗き込む姿勢は、首に最も静かで確実なダメージを与えます。</p>
				<p>そのうえで、キーボードによる手首角度、立ち座りを切り替える昇降デスク、足元を支えるフットレストといった要素が効いてきます。これらの選び方・比較は、今後この人間工学ピラーに順次追加していきます。デスク環境は一度の買い物ではなく、寸法を少しずつ合わせていく調整の連続です。</p>

				<div class="faq-container">
					<h2 style="border:none; padding:0;">よくある質問</h2>
					<div class="faq-item"><h4>Q: 最初に投資すべきは何ですか？</h4><p>椅子とデスク高さです。土台となる姿勢が崩れていると、周辺機器の効果は打ち消されてしまいます。</p></div>
					<div class="faq-item"><h4>Q: 高い製品ほど疲れませんか？</h4><p>価格より「自分の寸法に合っているか」が重要です。身長・座高に合わない高級品より、正しく調整された標準品のほうが疲れません。</p></div>
					<div class="faq-item"><h4>Q: 昇降デスクは本当に必要ですか？</h4><p>必須ではありませんが、同じ姿勢を続ける負担を分散できます。「疲れる」と感じる人ほど、切り替えの効果を実感しやすい傾向があります。</p></div>
				</div>

				<div class="cta-row">
					<a href="/category/functional-ergonomics/" class="cta-btn">エルゴノミクスの記事一覧</a>
					<a href="/" class="cta-btn">究極ガイドへ戻る</a>
				</div>
			</div>
		</main>
		<Footer />
	</body>
</html>
