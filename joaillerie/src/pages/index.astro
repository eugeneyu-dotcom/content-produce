---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getCollection } from 'astro:content';
import fs from 'node:fs';
import path from 'node:path';

// Helper to find the correct image extension (webp, jpg, png)
function findImage(basePath) {
	const exts = ['.webp', '.jpg', '.png', '.jpeg'];
	const publicDir = path.join(process.cwd(), 'public');

	// If path already has an extension, try to use it directly or check fallbacks
	let base = basePath;
	if (basePath.match(/\.(jpg|jpeg|png|webp)$/i)) {
		base = basePath.replace(/\.(jpg|jpeg|png|webp)$/i, '');
	}

	for (const ext of exts) {
		if (fs.existsSync(path.join(publicDir, base + ext))) {
			return base + ext;
		}
	}
	return ''; // blank if not found
}

const allPosts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const [coverPost, ...restPosts] = allPosts;
const listPosts = restPosts.slice(0, 5); // Contents-list entries beside the cover story

const styleGuideSlugs = ['superposer-colliers-guide-longueurs', 'or-argent-choisir-carnation-mythe'];
const styleGuidePosts = styleGuideSlugs
	.map((slug) => allPosts.find((post) => post.id === slug))
	.filter(Boolean);

// Hardcoded Pillar Posts based on SOP2-1
// User wants to manually manage pillar images under /media-images/
const pillars = [
	{ title: "Le Langage des Doigts", desc: "La topographie de la main et le message social.", bg: "/media-images/pillar-doigts.webp", link: "/category/symbolisme-des-bagues-par-doigt" },
	{ title: "L'Énergie des Pierres", desc: "La lithothérapie et la résonance émotionnelle.", bg: "/media-images/pillar-pierres.webp", link: "/category/vertus-spirituelles-des-pierres" },
	{ title: "Totems Sacrés", desc: "Les talismans protecteurs et le mauvais œil.", bg: "/media-images/pillar-totems.webp", link: "/category/totems-et-protection-antique" },
	{ title: "Alchimie des Métaux", desc: "L'or, l'argent et leur quête d'immortalité.", bg: "/media-images/pillar-metaux.webp", link: "/category/m-taux-et-nergie-alchimique" },
	{ title: "Rites de Passage", desc: "Naissance, union et deuil à travers les bijoux.", bg: "/media-images/pillar-rites.webp", link: "/category/bijoux-et-rites-de-passage" },
	{ title: "Identité et Styles", desc: "Du gothique au minimalisme, le bijou comme uniforme.", bg: "/media-images/pillar-styles.webp", link: "/category/styles-et-identit-sociale" }
];

const coverBasePath = coverPost?.data.heroImage ? coverPost.data.heroImage : `/media-images/post-${coverPost?.id}`;
const coverImage = coverPost ? findImage(coverBasePath) : '';
---

<!doctype html>
<html lang="fr">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;1,400&family=Lato:wght@300;400&display=swap" rel="stylesheet">
		<style>
			body {
				font-family: 'IBM Plex Sans', sans-serif;
				background-color: var(--bg-color, #F5EDF9);
				color: #333;
			}
			/* --- Hero Section --- */
			.hero {
				position: relative;
				text-align: center;
				padding: 8em 1em 6em;
				min-height: 55vh;
				display: flex;
				flex-direction: column;
				justify-content: center;
				align-items: center;
				background-image: url('/media-images/hero-bg.webp');
				background-size: cover;
				background-position: center;
				width: 100vw;
				margin-left: calc(-50vw + 50%);
				margin-right: calc(-50vw + 50%);
			}
			.hero-top-desc {
				font-size: 1em;
				text-transform: uppercase;
				letter-spacing: 3px;
				margin-bottom: 1.5em;
				color: #eee;
				text-shadow: 1px 1px 2px rgba(0,0,0,0.5);
			}
			.hero-overlay {
				position: absolute;
				top: 0; left: 0; right: 0; bottom: 0;
				background: rgba(51, 20, 56, 0.6);
				z-index: 1;
			}
			.hero-content {
				position: relative;
				z-index: 2;
				color: #fff;
			}
			.hero h2 {
				font-family: 'Playfair Display', serif;
				font-size: 3.2em;
				font-weight: 400;
				margin-bottom: 0.5em;
				text-shadow: 2px 2px 4px rgba(0,0,0,0.5);
			}
			.hero p {
				font-size: 1.15em;
				max-width: 600px;
				margin: 0 auto;
				line-height: 1.8;
				text-shadow: 1px 1px 3px rgba(0,0,0,0.5);
			}

			/* --- Shared section chrome --- */
			.masthead-rule {
				display: flex;
				align-items: center;
				gap: 1em;
				width: 100vw;
				margin-left: calc(-50vw + 50%);
				margin-right: calc(-50vw + 50%);
				margin-top: 3em;
				margin-bottom: 1.5em;
				padding: 0 7.5vw;
				box-sizing: border-box;
			}
			.masthead-rule .issue-no {
				font-family: 'Playfair Display', serif;
				font-style: italic;
				color: var(--accent, #9335B6);
				font-size: 1.1em;
				white-space: nowrap;
			}
			.masthead-rule .rule-line {
				flex: 1;
				height: 1px;
				background: #ddd;
			}
			.section-title {
				font-family: 'Playfair Display', serif;
				font-size: 2.2em;
				font-weight: 400;
				margin: 0 0.6em 0.6em;
				color: #222;
				width: 100vw;
				margin-left: calc(-50vw + 50%);
				margin-right: calc(-50vw + 50%);
				padding: 0 7.5vw;
				box-sizing: border-box;
			}

			/* --- Cover story + contents list --- */
			.front-page {
				width: 100vw;
				margin-left: calc(-50vw + 50%);
				margin-right: calc(-50vw + 50%);
				margin-bottom: 4em;
				padding: 0 7.5vw;
				box-sizing: border-box;
				display: grid;
				grid-template-columns: 1.5fr 1fr;
				gap: 3em;
			}
			.cover-story {
				position: relative;
				display: block;
				text-decoration: none;
				border-radius: 4px;
				overflow: hidden;
				min-height: 480px;
				background-size: cover;
				background-position: center;
				background-color: #eee;
			}
			.cover-story-overlay {
				position: absolute;
				inset: 0;
				background: linear-gradient(to top, rgba(20,8,22,0.92) 10%, rgba(20,8,22,0.35) 55%, transparent 85%);
			}
			.cover-story-body {
				position: absolute;
				bottom: 0; left: 0; right: 0;
				padding: 2.5em 2em 2em;
			}
			.cover-kicker {
				display: inline-block;
				color: #E8C5F5;
				font-size: 0.78em;
				text-transform: uppercase;
				letter-spacing: 2px;
				margin-bottom: 0.8em;
			}
			.cover-story h3 {
				font-family: 'Playfair Display', serif;
				font-size: 1.9em;
				font-weight: 400;
				color: #fff;
				margin: 0 0 0.3em;
				line-height: 1.25;
			}
			.cover-date {
				color: rgba(255,255,255,0.7);
				font-size: 0.85em;
				text-transform: uppercase;
				letter-spacing: 1px;
			}

			.contents-list {
				display: flex;
				flex-direction: column;
			}
			.contents-list-title {
				font-family: 'Playfair Display', serif;
				font-size: 1.1em;
				text-transform: uppercase;
				letter-spacing: 2px;
				color: #888;
				margin: 0 0 0.8em;
				padding-bottom: 0.6em;
				border-bottom: 1px solid #ddd;
			}
			.contents-item {
				display: flex;
				gap: 1em;
				align-items: baseline;
				padding: 1em 0;
				border-bottom: 1px solid #e5dced;
				text-decoration: none;
			}
			.contents-item:last-child {
				border-bottom: none;
			}
			.contents-num {
				font-family: 'Playfair Display', serif;
				font-style: italic;
				color: var(--accent, #9335B6);
				font-size: 1.3em;
				min-width: 1.5em;
			}
			.contents-item h4 {
				margin: 0;
				font-family: 'Playfair Display', serif;
				font-weight: 400;
				font-size: 1.08em;
				color: #222;
				line-height: 1.35;
				transition: color 0.2s ease;
			}
			.contents-item:hover h4 {
				color: var(--accent, #9335B6);
			}

			/* --- Style Guide Spotlight: filmstrip --- */
			.style-guide-section {
				width: 100vw;
				margin-left: calc(-50vw + 50%);
				margin-right: calc(-50vw + 50%);
				margin-bottom: 4em;
				padding: 0 7.5vw;
				box-sizing: border-box;
			}
			.style-guide-header {
				display: flex;
				justify-content: space-between;
				align-items: flex-end;
				flex-wrap: wrap;
				gap: 1em;
				margin-bottom: 1.5em;
			}
			.style-guide-kicker {
				display: inline-block;
				color: var(--accent, #9335B6);
				font-size: 0.78em;
				text-transform: uppercase;
				letter-spacing: 3px;
				border: 1px solid var(--accent, #9335B6);
				border-radius: 20px;
				padding: 0.3em 1.1em;
				margin-bottom: 0.5em;
			}
			.style-guide-title {
				font-family: 'Playfair Display', serif;
				font-size: 1.9em;
				font-weight: 400;
				color: #222;
				margin: 0;
			}
			.style-guide-archive-link {
				color: #666;
				text-decoration: none;
				font-size: 0.9em;
				text-transform: uppercase;
				letter-spacing: 1px;
				white-space: nowrap;
				transition: color 0.3s ease;
			}
			.style-guide-archive-link:hover {
				color: var(--accent, #9335B6);
			}
			.style-guide-strip {
				display: flex;
				gap: 1.5em;
				overflow-x: auto;
				padding-bottom: 0.5em;
				scroll-snap-type: x mandatory;
			}
			.style-guide-card {
				position: relative;
				display: block;
				flex: 0 0 auto;
				width: min(60vw, 420px);
				height: 300px;
				background-size: cover;
				background-position: center;
				background-color: #f5edf9;
				border-radius: 6px;
				overflow: hidden;
				text-decoration: none;
				scroll-snap-align: start;
				transition: transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1);
			}
			.style-guide-card:hover {
				transform: translateY(-6px);
			}
			.style-guide-card-content {
				position: absolute;
				bottom: 0; left: 0; right: 0;
				background: linear-gradient(to top, rgba(0,0,0,0.8), transparent);
				padding: 2.5em 1.5em 1.5em;
			}
			.style-guide-card h3 {
				font-family: 'Playfair Display', serif;
				font-weight: 400;
				font-size: 1.2em;
				color: #fff;
				margin: 0 0 0.4em;
				line-height: 1.3;
			}
			.style-guide-read {
				color: #E8C5F5;
				font-size: 0.85em;
				text-transform: uppercase;
				letter-spacing: 1px;
			}

			/* --- Pillars: numbered index --- */
			.pillar-index {
				width: 100vw;
				margin-left: calc(-50vw + 50%);
				margin-right: calc(-50vw + 50%);
				margin-bottom: 4em;
				padding: 0 7.5vw;
				box-sizing: border-box;
				display: grid;
				grid-template-columns: repeat(2, 1fr);
				gap: 0 3em;
			}
			.pillar-row {
				display: flex;
				align-items: center;
				gap: 1.2em;
				padding: 1.3em 0;
				border-bottom: 1px solid #ddd;
				text-decoration: none;
			}
			.pillar-row-num {
				font-family: 'Playfair Display', serif;
				font-size: 1.6em;
				color: #ccc;
				min-width: 1.4em;
			}
			.pillar-row-thumb {
				width: 64px;
				height: 64px;
				border-radius: 50%;
				background-size: cover;
				background-position: center;
				flex-shrink: 0;
				border: 2px solid #fff;
				box-shadow: 0 2px 8px rgba(0,0,0,0.15);
			}
			.pillar-row-text h3 {
				font-family: 'Playfair Display', serif;
				font-weight: 400;
				font-size: 1.15em;
				margin: 0 0 0.15em;
				color: #222;
				transition: color 0.2s ease;
			}
			.pillar-row-text p {
				margin: 0;
				font-size: 0.85em;
				color: #777;
			}
			.pillar-row:hover .pillar-row-text h3 {
				color: var(--accent, #9335B6);
			}

			@media (max-width: 860px) {
				.front-page {
					grid-template-columns: 1fr;
				}
				.pillar-index {
					grid-template-columns: 1fr;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<!-- Hero Section -->
			<section class="hero">
				<div class="hero-overlay"></div>
				<div class="hero-content">
					<div class="hero-top-desc">Bienvenue sur Joaillerie et Symbolique</div>
					<h2>Le Langage Secret des Bijoux</h2>
					<p>
						Plongez dans l'univers fascinant de la joaillerie. Découvrez la signification cachée des pierres précieuses,
						le symbolisme des bagues et l'histoire qui se cache derrière chaque parure.
					</p>
				</div>
			</section>

			<!-- Front Page: Cover Story + Contents List -->
			<div class="masthead-rule"><span class="issue-no">À la Une</span><span class="rule-line"></span></div>
			<div class="front-page">
				{coverPost && (
					<a href={`/blog/${coverPost.id}/`} class="cover-story" style={coverImage ? `background-image: url('${coverImage}');` : ''}>
						<div class="cover-story-overlay"></div>
						<div class="cover-story-body">
							<span class="cover-kicker">Dernière Publication</span>
							<h3>{coverPost.data.title}</h3>
							<span class="cover-date">
								<time datetime={coverPost.data.pubDate.toISOString()}>
									{coverPost.data.pubDate.toLocaleDateString('fr-FR', { year: 'numeric', month: 'long', day: 'numeric' })}
								</time>
							</span>
						</div>
					</a>
				)}
				<div class="contents-list">
					<div class="contents-list-title">Aussi Dans Cette Édition</div>
					{listPosts.map((post, i) => (
						<a href={`/blog/${post.id}/`} class="contents-item">
							<span class="contents-num">{String(i + 1).padStart(2, '0')}</span>
							<h4>{post.data.title}</h4>
						</a>
					))}
				</div>
			</div>

			<!-- Style Guide Spotlight -->
			<section class="style-guide-section">
				<div class="style-guide-header">
					<div>
						<span class="style-guide-kicker">Nouveau</span>
						<h2 class="style-guide-title">Guide de Style</h2>
					</div>
					<a href="/category/guide-de-style" class="style-guide-archive-link">Voir tous les guides &rarr;</a>
				</div>
				<div class="style-guide-strip">
					{styleGuidePosts.map((post) => {
						const basePath = post.data.heroImage ? post.data.heroImage : `/media-images/post-${post.id}`;
						const bgImage = findImage(basePath);
						return (
							<a href={`/blog/${post.id}/`} class="style-guide-card" style={bgImage ? `background-image: url('${bgImage}');` : ''}>
								<div class="style-guide-card-content">
									<h3>{post.data.title}</h3>
									<span class="style-guide-read">Lire le guide &rarr;</span>
								</div>
							</a>
						);
					})}
				</div>
			</section>

			<!-- Pillar Posts: Numbered Index -->
			<div class="masthead-rule"><span class="issue-no">L'Encyclopédie des Symboles</span><span class="rule-line"></span></div>
			<div class="pillar-index">
				{pillars.map((pillar, i) => (
					<a href={pillar.link} class="pillar-row">
						<span class="pillar-row-num">{String(i + 1).padStart(2, '0')}</span>
						<span class="pillar-row-thumb" style={pillar.bg ? `background-image: url('${pillar.bg}');` : ''}></span>
						<span class="pillar-row-text">
							<h3>{pillar.title}</h3>
							<p>{pillar.desc}</p>
						</span>
					</a>
				))}
			</div>
		</main>
		<Footer />
	</body>
</html>
