---
const today = new Date();
---

<footer class="colophon">
	<div class="colophon-rule"></div>
	<div class="colophon-content">
		<div class="colophon-mark">
			<span class="colophon-glyph">§</span>
		</div>

		<div class="colophon-brand">
			<div class="masthead-echo">Joaillerie et Symbolique</div>
			<p class="brand-desc">
				L'intelligence artificielle au service de la beauté, de l'histoire et de la culture. Nous créons des expériences digitales immersives pour décrypter le langage invisible du monde.
			</p>
		</div>

		<div class="colophon-index">
			<h3>Sommaire</h3>
			<a href="/category/vertus-spirituelles-des-pierres">L'Énergie des Pierres</a>
			<a href="/category/totems-et-protection-antique">Totems Sacrés</a>
			<a href="/category/m-taux-et-nergie-alchimique">Alchimie des Métaux</a>
			<a href="/category/bijoux-et-rites-de-passage">Rites de Passage</a>
			<a href="/category/guide-de-style">Guide de Style</a>
		</div>

		<div class="colophon-contact">
			<h3>Rédaction</h3>
			<a href="mailto:eugeneyu@maxora.ai" class="footer-btn">Contactez-nous</a>
			<a href="/politique-de-confidentialite" class="footer-btn footer-btn-ghost">Politique de Confidentialité</a>
		</div>
	</div>
	<div class="colophon-legal">
		<span>&copy; {today.getFullYear()} Joaillerie et Symbolique &amp; Maxora.ai. Tous droits réservés.</span>
		<span class="maxora-credit">Réalisé avec Maxora.ai</span>
	</div>
</footer>

<style>
	.colophon {
		background-color: var(--accent-dark, #331438);
		color: #ebd5f5;
		margin-top: 4em;
		font-family: 'IBM Plex Sans', sans-serif;
	}
	.colophon-rule {
		height: 1px;
		background: linear-gradient(to right, transparent, rgba(255,255,255,0.35), transparent);
	}
	.colophon-content {
		max-width: 1200px;
		margin: 0 auto;
		padding: 4em 2em 3em;
		display: grid;
		grid-template-columns: auto 1.6fr 1fr 1fr;
		gap: 3em;
		align-items: start;
	}
	.colophon-mark {
		font-family: 'Playfair Display', serif;
	}
	.colophon-glyph {
		display: block;
		font-size: 3.5em;
		line-height: 1;
		color: rgba(255,255,255,0.25);
	}
	.masthead-echo {
		font-family: 'Playfair Display', serif;
		font-size: 1.7em;
		font-weight: 400;
		color: #fff;
		letter-spacing: 2px;
		text-transform: uppercase;
		margin-bottom: 0.6em;
	}
	.brand-desc {
		font-size: 0.98em;
		line-height: 1.8;
		opacity: 0.8;
		max-width: 440px;
		margin: 0;
	}
	.colophon-index, .colophon-contact {
		display: flex;
		flex-direction: column;
		gap: 0.9em;
	}
	.colophon-index h3, .colophon-contact h3 {
		font-family: 'Playfair Display', serif;
		font-size: 1.1em;
		color: #fff;
		margin: 0 0 0.3em;
		font-weight: 400;
		text-transform: uppercase;
		letter-spacing: 1px;
	}
	.colophon-index a {
		color: #ebd5f5;
		opacity: 0.8;
		text-decoration: none;
		font-size: 0.92em;
		transition: opacity 0.2s ease;
	}
	.colophon-index a:hover {
		opacity: 1;
		text-decoration: underline;
	}
	.footer-btn {
		display: inline-block;
		padding: 10px 20px;
		background-color: rgba(255,255,255,0.05);
		border: 1px solid rgba(255,255,255,0.25);
		color: #fff;
		text-decoration: none;
		border-radius: 4px;
		transition: all 0.3s ease;
		font-size: 0.88em;
		text-align: center;
	}
	.footer-btn:hover {
		background-color: #fff;
		color: var(--accent-dark, #331438);
	}
	.footer-btn-ghost {
		background: none;
		border-color: rgba(255,255,255,0.15);
		opacity: 0.85;
	}
	.colophon-legal {
		border-top: 1px solid rgba(255,255,255,0.1);
		max-width: 1200px;
		margin: 0 auto;
		padding: 1.4em 2em;
		display: flex;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 0.5em;
		font-size: 0.82em;
		opacity: 0.6;
	}
	.maxora-credit {
		font-style: italic;
	}

	@media (max-width: 860px) {
		.colophon-content {
			grid-template-columns: 1fr 1fr;
		}
		.colophon-mark, .colophon-brand {
			grid-column: 1 / -1;
		}
	}
	@media (max-width: 560px) {
		.colophon-content {
			grid-template-columns: 1fr;
		}
		.colophon-legal {
			flex-direction: column;
		}
	}
</style>
