---
const today = new Date();
const categories = [
	{ label: 'Psychological Foundations & Anxiety', href: '/category/psychology-of-urban-legends' },
	{ label: 'Liminal Spaces & Modern Isolation', href: '/category/the-backrooms-explained' },
	{ label: 'Cryptids & Biological Anomalies', href: '/category/mothman-sightings-history' },
	{ label: 'Digital Folklore & Creepypastas', href: '/category/slender-man-origins' },
	{ label: 'Rituals & Forbidden Games', href: '/category/bloody-mary-ritual-legend' },
	{ label: 'Moral Panics & Societal Fears', href: '/category/moral-panic-urban-legends' },
	{ label: 'Cross-Cultural Folklore', href: '/category/cross-cultural-urban-legends' },
];
---

<footer class="case-cabinet">
	<div class="cabinet-stamp">END OF FILE</div>
	<div class="cabinet-body">
		<div class="cabinet-brand">
			<div class="cabinet-title">Global Urban Legends</div>
			<p class="cabinet-desc">Artificial intelligence uncovering the mysteries, myths, and legends that shape human culture — tracking the terrifying unknown as it spreads across the digital age.</p>
			<div class="cabinet-links">
				<a href="/privacy-policy">Privacy Policy</a>
				<a href="mailto:eugeneyu@maxora.ai">Contact Us</a>
			</div>
		</div>
		<div class="cabinet-index">
			<span class="cabinet-index-label">CASE INDEX</span>
			{categories.map((c) => (
				<a href={c.href} class="cabinet-row"><span class="redaction"></span>{c.label}</a>
			))}
		</div>
	</div>
	<div class="cabinet-copyright">
		&copy; {today.getFullYear()} Global Urban Legends &amp; Maxora.ai. All rights reserved.
	</div>
</footer>

<style>
	.case-cabinet {
		margin-top: 4em;
		background: #0D0D0D;
		border-top: 2px solid var(--accent, #B91C1C);
		font-family: 'Courier Prime', monospace;
		color: #D6D3CE;
	}
	.cabinet-stamp {
		text-align: center;
		font-family: 'Special Elite', cursive;
		color: var(--accent-dark, #7A1212);
		border: 2px solid var(--accent-dark, #7A1212);
		width: fit-content;
		margin: 2em auto 0;
		padding: 0.3em 1.2em;
		letter-spacing: 3px;
		transform: rotate(-2deg);
		font-size: 0.9em;
	}
	.cabinet-body {
		max-width: 1200px;
		margin: 0 auto;
		padding: 2em 1.6em 2.5em;
		display: grid;
		grid-template-columns: 1.3fr 1fr;
		gap: 3em;
	}
	.cabinet-title {
		font-family: 'Special Elite', cursive;
		font-size: 1.6em;
		color: #D6D3CE;
		margin-bottom: 0.6em;
	}
	.cabinet-desc {
		font-size: 0.92em;
		line-height: 1.8;
		opacity: 0.8;
		margin: 0 0 1.5em;
	}
	.cabinet-links {
		display: flex;
		gap: 1.5em;
	}
	.cabinet-links a {
		color: #D6D3CE;
		text-decoration: none;
		border: 1px solid rgba(232,226,213,0.25);
		padding: 0.6em 1.2em;
		font-size: 0.85em;
		transition: all 0.2s ease;
	}
	.cabinet-links a:hover {
		border-color: var(--accent, #B91C1C);
		color: var(--accent, #B91C1C);
	}
	.cabinet-index-label {
		display: block;
		font-size: 0.72em;
		letter-spacing: 2px;
		color: var(--accent, #B91C1C);
		margin-bottom: 1em;
	}
	.cabinet-row {
		display: flex;
		align-items: center;
		gap: 0.7em;
		padding: 0.55em 0;
		border-bottom: 1px solid rgba(185,28,28,0.15);
		color: #D6D3CE;
		text-decoration: none;
		font-size: 0.85em;
	}
	.cabinet-row:last-child {
		border-bottom: none;
	}
	.cabinet-row:hover {
		color: var(--accent, #B91C1C);
	}
	.redaction {
		display: inline-block;
		width: 12px;
		height: 9px;
		background: var(--accent-dark, #7A1212);
		flex-shrink: 0;
	}
	.cabinet-copyright {
		border-top: 1px solid rgba(232,226,213,0.12);
		max-width: 1200px;
		margin: 0 auto;
		padding: 1.2em 1.6em;
		font-size: 0.78em;
		opacity: 0.55;
	}

	@media (max-width: 780px) {
		.cabinet-body {
			grid-template-columns: 1fr;
			gap: 2em;
		}
	}
</style>
