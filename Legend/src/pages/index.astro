---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getCollection } from 'astro:content';
import fs from 'node:fs';
import path from 'node:path';

// Helper to find the correct image extension (webp, jpg, png)
function findImage(basePath) {
	const exts = ['.webp', '.jpg', '.png', '.jpeg'];
	const publicDir = path.join(process.cwd(), 'public');
	
	let base = basePath;
	if (basePath.match(/\.(jpg|jpeg|png|webp)$/i)) {
		base = basePath.replace(/\.(jpg|jpeg|png|webp)$/i, '');
	}

	for (const ext of exts) {
		if (fs.existsSync(path.join(publicDir, base + ext))) {
			return base + ext;
		}
	}
	return '';
}

const allPosts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const posts = allPosts.slice(0, 6);

const onScreenSlugs = ['slender-man-video-game-viral-origin', 'horror-movies-based-on-real-urban-legends', 'kokkuri-san-how-to-play', 'daruma-san-bath-game-ritual'];
const onScreenPosts = onScreenSlugs
	.map((slug) => allPosts.find((post) => post.id === slug))
	.filter(Boolean);

const pillars = [
	{ title: "Psychological Foundations & Anxiety", desc: "Understanding the human fears behind the myths.", bg: "/media-images/pillar-psychology.webp", link: "/category/psychology-of-urban-legends" },
	{ title: "Liminal Spaces & Modern Isolation", desc: "The dread of backrooms and empty hallways.", bg: "/media-images/pillar-liminal.webp", link: "/category/the-backrooms-explained" },
	{ title: "Cryptids & Biological Anomalies", desc: "Monsters that haunt the fringes of civilization.", bg: "/media-images/pillar-cryptids.webp", link: "/category/mothman-sightings-history" },
	{ title: "Digital Folklore & Creepypastas", desc: "Open-source horror in the digital age.", bg: "/media-images/pillar-digital.webp", link: "/category/slender-man-origins" },
	{ title: "Rituals & Forbidden Games", desc: "The performative thrill of summoning the unknown.", bg: "/media-images/pillar-rituals.webp", link: "/category/bloody-mary-ritual-legend" },
	{ title: "Moral Panics & Societal Fears", desc: "Hysteria and the weaponization of urban legends.", bg: "/media-images/pillar-panics.webp", link: "/category/moral-panic-urban-legends" },
	{ title: "Cross-Cultural Folklore", desc: "Universal fears translated into cultural metaphors.", bg: "/media-images/pillar-cultural.webp", link: "/category/cross-cultural-urban-legends" }
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			body {
				font-family: 'Courier Prime', monospace;
				background-color: var(--bg-color, #0D0D0D);
				color: #D6D3CE;
			}
			/* --- Hero Section --- */
			.hero {
				position: relative;
				text-align: center;
				padding: 10em 1em;
				min-height: 70vh;
				display: flex;
				flex-direction: column;
				justify-content: center;
				align-items: center;
				margin-bottom: 3em;
				background-image: url('/media-images/hero-bg.webp');
				background-size: cover;
				background-position: center;
				width: 100vw;
				margin-left: calc(-50vw + 50%);
				margin-right: calc(-50vw + 50%);
				filter: grayscale(0.4) contrast(1.2);
				box-shadow: inset 0 0 150px rgba(185, 28, 28, 0.3);
			}
			.hero-top-desc {
				font-size: 1em;
				text-transform: uppercase;
				letter-spacing: 3px;
				margin-bottom: 1.5em;
				color: var(--accent, #B91C1C);
				text-shadow: 1px 1px 4px rgba(0,0,0,0.8);
			}
			.hero-overlay {
				position: absolute;
				top: 0; left: 0; right: 0; bottom: 0;
				background: rgba(13, 13, 13, 0.6);
				z-index: 1;
			}
			.hero-content {
				position: relative;
				z-index: 2;
				color: #fff;
				filter: none;
			}
			.hero h2 {
				font-family: 'Special Elite', cursive;
				font-size: 4em;
				font-weight: 400;
				margin-bottom: 0.5em;
				text-shadow: 2px 2px 4px rgba(0,0,0,0.8);
				color: #D6D3CE;
				letter-spacing: 0.05em;
			}
			.hero p {
				font-size: 1.2em;
				max-width: 600px;
				margin: 0 auto;
				line-height: 1.8;
				text-shadow: 1px 1px 3px rgba(0,0,0,0.8);
			}

			/* --- Section Titles --- */
			.section-title {
				text-align: center;
				font-family: 'Special Elite', cursive;
				font-size: 3em;
				font-weight: 400;
				margin: 2em 0 1em;
				color: #D6D3CE;
			}
			.section-title::after {
				content: '';
				display: block;
				width: 60px;
				height: 2px;
				background-color: var(--accent, #B91C1C);
				margin: 0.5em auto 0;
			}

			/* --- On Screen Spotlight --- */
			.on-screen-section {
				max-width: 1200px;
				margin: 0 auto 4em;
				padding: 2.5em 2em;
				background: #1A1816;
				border: 1px solid var(--accent-dark, #7A1212);
				border-radius: 4px;
				box-shadow: 0 4px 25px rgba(0,0,0,0.5);
			}
			.on-screen-header {
				text-align: center;
				margin-bottom: 2em;
			}
			.on-screen-kicker {
				display: inline-block;
				color: var(--accent, #B91C1C);
				font-size: 0.85em;
				text-transform: uppercase;
				letter-spacing: 3px;
				border: 1px solid var(--accent, #B91C1C);
				padding: 0.3em 1em;
				margin-bottom: 1em;
			}
			.on-screen-title {
				font-family: 'Special Elite', cursive;
				font-size: 2.4em;
				font-weight: 400;
				color: #fff;
				margin: 0.2em 0;
			}
			.on-screen-intro {
				color: #D6D3CE;
				max-width: 560px;
				margin: 0.5em auto 0;
				line-height: 1.7;
			}
			.on-screen-grid {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
				gap: 2em;
			}
			.on-screen-card {
				position: relative;
				display: block;
				height: 300px;
				background-size: cover;
				background-position: center;
				background-color: #0D0D0D;
				border-radius: 4px;
				overflow: hidden;
				text-decoration: none;
				filter: grayscale(0.4) contrast(1.2);
				transition: filter 0.3s ease, transform 0.3s ease;
			}
			.on-screen-card:hover {
				filter: grayscale(0.1) contrast(1.2);
				transform: translateY(-4px);
			}
			.on-screen-card-content {
				position: absolute;
				bottom: 0; left: 0; right: 0;
				background: linear-gradient(to top, rgba(13,13,13,0.95), transparent);
				padding: 2.5em 1.5em 1.5em;
			}
			.on-screen-card h3 {
				font-family: 'Courier Prime', monospace;
				font-weight: 700;
				font-size: 1.2em;
				color: #fff;
				margin: 0 0 0.4em;
				line-height: 1.3;
			}
			.on-screen-read {
				color: var(--accent, #E05252);
				font-size: 0.85em;
				text-transform: uppercase;
				letter-spacing: 1px;
			}
			.on-screen-archive-link {
				display: block;
				text-align: center;
				margin-top: 2em;
				color: #D6D3CE;
				text-decoration: none;
				font-size: 0.95em;
				text-transform: uppercase;
				letter-spacing: 1px;
				border-top: 1px solid rgba(185,28,28,0.3);
				padding-top: 1.5em;
				transition: color 0.3s ease;
			}
			.on-screen-archive-link:hover {
				color: var(--accent, #B91C1C);
			}

			/* --- Category dossier: stacked case files, auto-fit so it's mobile-first by construction --- */
			.dossier-grid {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
				gap: 1.5em;
				max-width: 1300px;
				margin: 0 auto 4em;
				padding: 0 1.2em;
			}
			.dossier-card {
				position: relative;
				display: block;
				background: #1A1816;
				border: 1px solid rgba(185,28,28,0.3);
				text-decoration: none;
				overflow: hidden;
				transition: border-color 0.2s ease;
			}
			.dossier-card:hover {
				border-color: var(--accent, #B91C1C);
			}
			.dossier-tab {
				position: absolute;
				top: 0;
				left: 1.2em;
				background: var(--accent-dark, #7A1212);
				color: #fff;
				font-size: 0.68em;
				letter-spacing: 1px;
				padding: 0.3em 0.8em;
				z-index: 2;
			}
			.dossier-thumb {
				display: block;
				width: 100%;
				aspect-ratio: 16 / 10;
				background-size: cover;
				background-position: center;
				background-color: #0D0D0D;
				filter: grayscale(0.4) contrast(1.2);
				transition: filter 0.3s ease;
			}
			.dossier-card:hover .dossier-thumb {
				filter: grayscale(0.1) contrast(1.2);
			}
			.dossier-label {
				display: block;
				padding: 1.4em 1.2em 1.2em;
				border-top: 1px solid rgba(185,28,28,0.2);
			}
			.dossier-label h3 {
				font-family: 'Special Elite', cursive;
				font-size: 1.25em;
				margin: 0 0 0.3em;
				color: #fff;
				letter-spacing: 0.02em;
			}
			.dossier-label p {
				font-size: 0.85em;
				margin: 0;
				color: #A39D93;
				line-height: 1.6;
			}

			/* --- Latest Archives: evidence list, single column on mobile by construction --- */
			.evidence-list {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
				gap: 1.5em;
				max-width: 1300px;
				margin: 0 auto 4em;
				padding: 0 1.2em;
				list-style: none;
			}
			.evidence-card {
				position: relative;
				background: #1A1816;
				border: 1px solid rgba(185,28,28,0.25);
			}
			.evidence-card a {
				display: block;
				text-decoration: none;
				color: inherit;
			}
			.evidence-thumb {
				display: block;
				width: 100%;
				aspect-ratio: 16 / 10;
				background-size: cover;
				background-position: center;
				background-color: #0D0D0D;
				filter: grayscale(0.4) contrast(1.2);
			}
			.evidence-body {
				display: block;
				padding: 1.2em 1.3em 1.4em;
				border-top: 3px solid var(--accent, #B91C1C);
				background: #E8E2D5;
			}
			.evidence-stamp {
				display: inline-block;
				font-size: 0.72em;
				color: var(--accent-dark, #7A1212);
				border: 1px solid var(--accent-dark, #7A1212);
				padding: 0.15em 0.6em;
				letter-spacing: 1px;
				transform: rotate(-2deg);
				margin-bottom: 0.6em;
			}
			.evidence-card h3 {
				font-family: 'Courier Prime', monospace;
				font-size: 1.15em;
				font-weight: 700;
				margin: 0;
				line-height: 1.4;
				color: #2A2723;
			}

			@media (max-width: 640px) {
				.hero {
					padding: 6em 1em;
				}
				.hero h2 {
					font-size: 2.4em;
				}
				.section-title {
					font-size: 2em;
				}
				.on-screen-section {
					padding: 1.6em 1.2em;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<!-- Hero Section -->
			<section class="hero">
				<div class="hero-overlay"></div>
				<div class="hero-content">
					<div class="hero-top-desc">Welcome to The Global Encyclopedia of Urban Legends</div>
					<h2>Myths That Haunt Us</h2>
					<p>
						Explore the darkest corners of human anxiety, digital folklore, and terrifying cross-cultural tales that lurk in the shadows.
					</p>
				</div>
			</section>

			<!-- On Screen Spotlight -->
			<section class="on-screen-section">
				<div class="on-screen-header">
					<span class="on-screen-kicker">Latest Dispatch</span>
					<h2 class="on-screen-title">Legends on Screen</h2>
					<p class="on-screen-intro">Where cryptids and creepypastas go when they leave the page — tracked here as new games and films adapt them.</p>
				</div>
				<div class="on-screen-grid">
					{onScreenPosts.map((post) => {
						const basePath = post.data.heroImage ? post.data.heroImage : `/media-images/post-${post.id}`;
						const bgImage = findImage(basePath);
						return (
							<a href={`/blog/${post.id}/`} class="on-screen-card" style={bgImage ? `background-image: url('${bgImage}');` : ''}>
								<div class="on-screen-card-content">
									<h3>{post.data.title}</h3>
									<span class="on-screen-read">Read the file &rarr;</span>
								</div>
							</a>
						);
					})}
				</div>
				<a href="/category/legends-on-screen" class="on-screen-archive-link">Browse the full archive &rarr;</a>
			</section>

			<!-- Category dossier: stacked case files -->
			<h2 class="section-title">Dimensions of Fear</h2>
			<div class="dossier-grid">
				{pillars.map((pillar, i) => (
					<a href={pillar.link} class="dossier-card">
						<span class="dossier-tab">FILE #{String(i + 1).padStart(3, '0')}</span>
						<span class="dossier-thumb" style={pillar.bg ? `background-image: url('${pillar.bg}');` : ''}></span>
						<span class="dossier-label">
							<h3>{pillar.title}</h3>
							<p>{pillar.desc}</p>
						</span>
					</a>
				))}
			</div>

			<!-- Latest Archives: evidence list -->
			<h2 class="section-title">Latest Archives</h2>
			<ul class="evidence-list">
				{
					posts.map((post) => {
						const basePath = post.data.heroImage ? post.data.heroImage : `/media-images/post-${post.id}`;
						const bgImage = findImage(basePath);

						return (
						<li class="evidence-card">
							<a href={`/blog/${post.id}/`}>
								<span class="evidence-thumb" style={bgImage ? `background-image: url('${bgImage}');` : ''}></span>
								<span class="evidence-body">
									<span class="evidence-stamp">
										<time datetime={post.data.pubDate.toISOString()}>
											{post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
										</time>
									</span>
									<h3>{post.data.title}</h3>
								</span>
							</a>
						</li>
					)})
				}
			</ul>
		</main>
		<Footer />
	</body>
</html>