---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Terms of Use & Disclaimer | ${SITE_TITLE}`} description="Terms of use and disclaimer for Global Urban Legends" />
		<style>
			body {
				font-family: 'Courier Prime', monospace;
				background-color: var(--bg-color, #0D0D0D);
				color: #D6D3CE;
				margin: 0;
			}
			.hero {
				position: relative;
				text-align: center;
				padding: 6em 1em;
				background-color: var(--accent-dark, #7A1212);
				width: 100vw;
				margin-left: calc(-50vw + 50%);
				margin-right: calc(-50vw + 50%);
				border-bottom: 2px solid var(--accent, #B91C1C);
			}
			.hero h1 {
				font-family: 'Special Elite', cursive;
				font-size: 3.5em;
				font-weight: 400;
				margin-bottom: 0.2em;
				letter-spacing: 0.05em;
				color: #fff;
			}

			.content-section {
				width: 75vw;
				max-width: 75vw;
				margin-top: 4em;
				margin-bottom: 4em;
				margin-left: calc(-37.5vw + 50%);
				margin-right: calc(-37.5vw + 50%);
				padding: 3em;
				background: #E8E2D5;
				border-radius: 12px;
				box-shadow: 0 10px 30px rgba(0,0,0,0.8);
				border: 1px solid rgba(122, 18, 18, 0.3);
				line-height: 1.8;
				box-sizing: border-box;
				color: #2A2723;
			}
			.content-section h3 {
				font-family: 'Special Elite', cursive;
				font-size: 2.2em;
				color: var(--accent-dark, #7A1212);
				border-bottom: 1px solid rgba(122, 18, 18, 0.2);
				padding-bottom: 10px;
				margin-top: 1.5em;
				margin-bottom: 0.8em;
			}
			.content-section p {
				font-size: 1.1em;
				color: #2A2723;
				margin-bottom: 1.5em;
			}

			.content-section a {
				color: var(--accent, #B91C1C);
				text-decoration: underline;
			}

			.image-container {
				text-align: center;
				margin: 4em 0;
			}
			.image-container img {
				max-width: 100%;
				border-radius: 8px;
				box-shadow: 0 10px 25px rgba(0,0,0,0.5);
				filter: grayscale(0.4) contrast(1.2);
			}
		</style>
	</head>
	<body>
		<Header />
		<main style="padding-top:0;">
			<section class="hero">
				<h1>Terms of Use &amp; Disclaimer</h1>
			</section>

			<section class="content-section">
				<h3>General information only</h3>
				<p>Global Urban Legends is provided for entertainment, cultural and educational purposes. Many of the stories we discuss are unverified folklore, and we try to say clearly when a claim cannot be confirmed.</p>
				<h3>Safety</h3>
				<p>Some articles describe rituals, summoning games or "legend tripping". We describe them for cultural and historical interest only. We do not encourage anyone to try them, to trespass, or to put themselves or others at risk.</p>
				<h3>Accuracy and corrections</h3>
				<p>We try to be accurate, but we make no warranty that the content is complete or current. Some articles are older and are being reviewed. To report a mistake, see our <a href="/contact">contact page</a>.</p>
				<h3>How content is made</h3>
				<p>Articles are written with the help of AI tools and reviewed by a person. See our <a href="/about-us">About page</a> for details.</p>
				<h3>Copyright</h3>
				<p>All original content on this site is owned by its operator. You may quote short excerpts with a link back to the source article. Please do not republish full articles without permission.</p>
				<h3>External links</h3>
				<p>Articles may link to external websites. We are not responsible for the content or practices of those sites.</p>
				<h3>Advertising</h3>
				<p>This site may display advertising, including Google AdSense. See our <a href="/privacy-policy">Privacy Policy</a> for how advertising cookies are handled.</p>
				<h3>Changes</h3>
				<p>We may update these terms from time to time. Last updated: October 15, 2026.</p>
			</section>
		</main>
		<Footer />
	</body>
</html>