---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Contact Us | ${SITE_TITLE}`} description="Contact Global Urban Legends for corrections, submissions and inquiries" />
		<style>
			body {
				font-family: 'Courier Prime', monospace;
				background-color: var(--bg-color, #0D0D0D);
				color: #D6D3CE;
				margin: 0;
			}
			.hero {
				position: relative;
				text-align: center;
				padding: 6em 1em;
				background-color: var(--accent-dark, #7A1212);
				width: 100vw;
				margin-left: calc(-50vw + 50%);
				margin-right: calc(-50vw + 50%);
				border-bottom: 2px solid var(--accent, #B91C1C);
			}
			.hero h1 {
				font-family: 'Special Elite', cursive;
				font-size: 3.5em;
				font-weight: 400;
				margin-bottom: 0.2em;
				letter-spacing: 0.05em;
				color: #fff;
			}

			.content-section {
				width: 75vw;
				max-width: 75vw;
				margin-top: 4em;
				margin-bottom: 4em;
				margin-left: calc(-37.5vw + 50%);
				margin-right: calc(-37.5vw + 50%);
				padding: 3em;
				background: #E8E2D5;
				border-radius: 12px;
				box-shadow: 0 10px 30px rgba(0,0,0,0.8);
				border: 1px solid rgba(122, 18, 18, 0.3);
				line-height: 1.8;
				box-sizing: border-box;
				color: #2A2723;
			}
			.content-section h3 {
				font-family: 'Special Elite', cursive;
				font-size: 2.2em;
				color: var(--accent-dark, #7A1212);
				border-bottom: 1px solid rgba(122, 18, 18, 0.2);
				padding-bottom: 10px;
				margin-top: 1.5em;
				margin-bottom: 0.8em;
			}
			.content-section p {
				font-size: 1.1em;
				color: #2A2723;
				margin-bottom: 1.5em;
			}

			.content-section a {
				color: var(--accent, #B91C1C);
				text-decoration: underline;
			}

			.image-container {
				text-align: center;
				margin: 4em 0;
			}
			.image-container img {
				max-width: 100%;
				border-radius: 8px;
				box-shadow: 0 10px 25px rgba(0,0,0,0.5);
				filter: grayscale(0.4) contrast(1.2);
			}
		</style>
	</head>
	<body>
		<Header />
		<main style="padding-top:0;">
			<section class="hero">
				<h1>Contact Us</h1>
			</section>

			<section class="content-section">
				<h3>Get in touch</h3>
				<p>You can reach us by email at <a href="mailto:eugeneyu@maxora.ai">eugeneyu@maxora.ai</a>. Global Urban Legends is run by Maxora.ai.</p>
				<h3>Corrections</h3>
				<p>If you spot a factual error or an unsupported claim in an article, send us the article URL and describe the problem. We review corrections and update the article when needed.</p>
				<h3>Submit a local legend</h3>
				<p>Have an urban legend or local story you think we should look into? Email it to us. We read submissions but cannot promise to write about every one.</p>
				<h3>Business inquiries</h3>
				<p>Business and partnership inquiries are welcome at the same address.</p>
			</section>
		</main>
		<Footer />
	</body>
</html>