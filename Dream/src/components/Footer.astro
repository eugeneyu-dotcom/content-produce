---
const today = new Date();
const categories = [
	{ label: 'Neurobiological Foundations', href: '/category/rem-sleep-neuroscience' },
	{ label: 'Jungian Archetypes', href: '/category/jungian-archetypes' },
	{ label: 'Freudian Psychoanalysis', href: '/category/freudian-dreamwork' },
	{ label: 'Evolutionary Threat Simulation', href: '/category/evolutionary-nightmares' },
	{ label: 'Universal Symbolic Themes', href: '/category/falling-in-dreams-meaning' },
	{ label: 'Lucid Dreaming & Agency', href: '/category/lucid-dreaming-guide' },
	{ label: 'Cultural & Spiritual Evolution', href: '/category/history-of-dream-interpretation' },
];
---

<footer class="dream-footer-wrap">
	<div class="dream-footer-card">
		<div class="footer-top">
			<div class="footer-mark">
				<span class="footer-glyph">☾</span>
				<span class="footer-name">Encyclopedia of Dreams</span>
			</div>
			<p class="brand-desc">
				Artificial intelligence exploring the collective unconscious — decoding the mysteries of your mind, one symbol at a time.
			</p>
		</div>

		<div class="footer-index">
			<h3>Full Index</h3>
			<div class="footer-index-list">
				{categories.map((cat) => <a href={cat.href}>{cat.label}</a>)}
			</div>
		</div>

		<div class="footer-bottom">
			<span>&copy; {today.getFullYear()} The Master Encyclopedia of Dreams &amp; Maxora.ai</span>
			<div class="footer-actions">
				<a href="/privacy-policy">Privacy Policy</a>
				<a href="mailto:eugeneyu@maxora.ai">Contact Us</a>
			</div>
		</div>
	</div>
</footer>

<style>
	.dream-footer-wrap {
		margin-top: 5em;
		padding: 0 1.5em 3em;
	}
	.dream-footer-card {
		max-width: 1200px;
		margin: 0 auto;
		background: rgba(255,255,255,0.04);
		backdrop-filter: blur(16px);
		-webkit-backdrop-filter: blur(16px);
		border: 1px solid rgba(167, 139, 250, 0.25);
		border-radius: 24px;
		padding: 3em;
		box-shadow: 0 20px 60px rgba(0,0,0,0.4);
		font-family: 'Manrope', sans-serif;
		color: #E2DCF5;
	}
	.footer-top {
		margin-bottom: 2em;
	}
	.footer-mark {
		display: flex;
		align-items: center;
		gap: 0.6em;
		margin-bottom: 0.8em;
	}
	.footer-glyph {
		font-size: 1.6em;
		color: var(--accent, #A78BFA);
		text-shadow: 0 0 16px rgba(167, 139, 250, 0.6);
	}
	.footer-name {
		font-family: 'Cormorant Garamond', serif;
		font-style: italic;
		font-size: 1.6em;
		color: #F5F1FE;
	}
	.brand-desc {
		font-size: 1em;
		line-height: 1.8;
		opacity: 0.75;
		max-width: 560px;
		margin: 0;
	}
	.footer-index {
		border-top: 1px solid rgba(167, 139, 250, 0.2);
		padding-top: 2em;
		margin-bottom: 2em;
	}
	.footer-index h3 {
		font-family: 'Cormorant Garamond', serif;
		font-style: italic;
		font-size: 1.1em;
		color: var(--accent, #A78BFA);
		margin: 0 0 1em;
		font-weight: 500;
	}
	.footer-index-list {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6em;
	}
	.footer-index-list a {
		color: #E2DCF5;
		text-decoration: none;
		font-size: 0.85em;
		padding: 0.5em 1em;
		border: 1px solid rgba(167, 139, 250, 0.25);
		border-radius: 999px;
		opacity: 0.85;
		transition: all 0.2s ease;
	}
	.footer-index-list a:hover {
		opacity: 1;
		background: rgba(167, 139, 250, 0.15);
		border-color: var(--accent, #A78BFA);
	}
	.footer-bottom {
		display: flex;
		justify-content: space-between;
		align-items: center;
		flex-wrap: wrap;
		gap: 1em;
		border-top: 1px solid rgba(167, 139, 250, 0.2);
		padding-top: 1.6em;
		font-size: 0.85em;
		opacity: 0.65;
	}
	.footer-actions {
		display: flex;
		gap: 1.5em;
	}
	.footer-actions a {
		color: #E2DCF5;
		text-decoration: none;
	}
	.footer-actions a:hover {
		color: var(--accent, #A78BFA);
	}

	@media (max-width: 560px) {
		.dream-footer-card {
			padding: 2em 1.5em;
		}
		.footer-bottom {
			flex-direction: column;
			align-items: flex-start;
		}
	}
</style>
