---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Contact Us | ${SITE_TITLE}`} description="Contact Encyclopedia of Dreams for corrections, feedback and inquiries" />
		<style>
			body {
				font-family: 'Manrope', sans-serif;
				background-color: var(--bg-color, #0B0618);
				color: #E2DCF5;
				margin: 0;
			}
			.hero {
				position: relative;
				text-align: center;
				padding: 6em 1em;
				background-color: var(--accent-dark, #5B21B6);
				background-image:
					radial-gradient(circle at 20% 30%, rgba(167, 139, 250, 0.35) 0%, transparent 50%),
					radial-gradient(circle at 80% 70%, rgba(103, 232, 249, 0.20) 0%, transparent 50%);
				width: 100vw;
				margin-left: calc(-50vw + 50%);
				margin-right: calc(-50vw + 50%);
				border-bottom: 2px solid var(--accent, #A78BFA);
			}
			.hero h1 {
				font-family: 'Cormorant Garamond', serif;
				font-size: 3em;
				font-weight: 500;
				margin-bottom: 0.2em;
				letter-spacing: 2px;
				color: #F5F1FE;
				text-shadow: 0 0 20px rgba(167, 139, 250, 0.4);
			}

			.content-section {
				width: 75vw;
				max-width: 75vw;
				margin-top: 4em;
				margin-bottom: 4em;
				margin-left: calc(-37.5vw + 50%);
				margin-right: calc(-37.5vw + 50%);
				padding: 3em;
				background: rgba(255,255,255,0.04);
				backdrop-filter: blur(12px);
				-webkit-backdrop-filter: blur(12px);
				border-radius: 16px;
				box-shadow: 0 10px 30px rgba(0,0,0,0.5);
				border: 1px solid rgba(255,255,255,0.08);
				line-height: 1.8;
				box-sizing: border-box;
			}
			.content-section h3 {
				font-family: 'Cormorant Garamond', serif;
				font-size: 1.8em;
				font-weight: 600;
				color: var(--accent, #A78BFA);
				border-bottom: 1px solid rgba(167, 139, 250, 0.2);
				padding-bottom: 10px;
				margin-top: 1.5em;
				margin-bottom: 0.8em;
			}
			.content-section p {
				font-size: 1.1em;
				color: #E2DCF5;
				margin-bottom: 1.5em;
			}

			.content-section a {
				color: var(--accent, #A78BFA);
				text-decoration: underline;
			}
			
			.image-container {
				text-align: center;
				margin: 4em 0;
			}
			.image-container img {
				max-width: 100%;
				border-radius: 8px;
				box-shadow: 0 10px 25px rgba(0,0,0,0.5);
			}
		</style>
	</head>
	<body>
		<Header />
		<main style="padding-top:0;">
			<section class="hero">
				<h1>Contact Us</h1>
			</section>

			<section class="content-section">
				<h3>Get in touch</h3>
				<p>You can reach us by email at <a href="mailto:eugeneyu@maxora.ai">eugeneyu@maxora.ai</a>. Encyclopedia of Dreams is run by Maxora.ai.</p>
				<h3>Corrections</h3>
				<p>If you find a factual error or an outdated claim in an article, please send us the article URL and describe what is wrong. We review corrections and update the article when needed.</p>
				<h3>Feedback and business inquiries</h3>
				<p>Questions, suggestions and business inquiries are welcome at the same address. We read every message, but we cannot promise a reply to each one.</p>
				<h3>A note on dream advice</h3>
				<p>We cannot interpret your personal dreams by email or give medical or psychological advice. If you are struggling with sleep or distressing dreams, please speak to a qualified professional.</p>
			</section>
		</main>
		<Footer />
	</body>
</html>