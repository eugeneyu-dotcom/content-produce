---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Terms of Use & Disclaimer | ${SITE_TITLE}`} description="Terms of use and disclaimer for Encyclopedia of Dreams" />
		<style>
			body {
				font-family: 'Manrope', sans-serif;
				background-color: var(--bg-color, #0B0618);
				color: #E2DCF5;
				margin: 0;
			}
			.hero {
				position: relative;
				text-align: center;
				padding: 6em 1em;
				background-color: var(--accent-dark, #5B21B6);
				background-image:
					radial-gradient(circle at 20% 30%, rgba(167, 139, 250, 0.35) 0%, transparent 50%),
					radial-gradient(circle at 80% 70%, rgba(103, 232, 249, 0.20) 0%, transparent 50%);
				width: 100vw;
				margin-left: calc(-50vw + 50%);
				margin-right: calc(-50vw + 50%);
				border-bottom: 2px solid var(--accent, #A78BFA);
			}
			.hero h1 {
				font-family: 'Cormorant Garamond', serif;
				font-size: 3em;
				font-weight: 500;
				margin-bottom: 0.2em;
				letter-spacing: 2px;
				color: #F5F1FE;
				text-shadow: 0 0 20px rgba(167, 139, 250, 0.4);
			}

			.content-section {
				width: 75vw;
				max-width: 75vw;
				margin-top: 4em;
				margin-bottom: 4em;
				margin-left: calc(-37.5vw + 50%);
				margin-right: calc(-37.5vw + 50%);
				padding: 3em;
				background: rgba(255,255,255,0.04);
				backdrop-filter: blur(12px);
				-webkit-backdrop-filter: blur(12px);
				border-radius: 16px;
				box-shadow: 0 10px 30px rgba(0,0,0,0.5);
				border: 1px solid rgba(255,255,255,0.08);
				line-height: 1.8;
				box-sizing: border-box;
			}
			.content-section h3 {
				font-family: 'Cormorant Garamond', serif;
				font-size: 1.8em;
				font-weight: 600;
				color: var(--accent, #A78BFA);
				border-bottom: 1px solid rgba(167, 139, 250, 0.2);
				padding-bottom: 10px;
				margin-top: 1.5em;
				margin-bottom: 0.8em;
			}
			.content-section p {
				font-size: 1.1em;
				color: #E2DCF5;
				margin-bottom: 1.5em;
			}

			.content-section a {
				color: var(--accent, #A78BFA);
				text-decoration: underline;
			}
			
			.image-container {
				text-align: center;
				margin: 4em 0;
			}
			.image-container img {
				max-width: 100%;
				border-radius: 8px;
				box-shadow: 0 10px 25px rgba(0,0,0,0.5);
			}
		</style>
	</head>
	<body>
		<Header />
		<main style="padding-top:0;">
			<section class="hero">
				<h1>Terms of Use &amp; Disclaimer</h1>
			</section>

			<section class="content-section">
				<h3>General information only</h3>
				<p>The content of Encyclopedia of Dreams is provided for general informational and educational purposes. Dream interpretation is subjective and based on theories and traditions rather than established fact.</p>
				<h3>Not professional advice</h3>
				<p>Nothing on this site is medical, psychological or therapeutic advice, and it is not a substitute for a qualified professional. If you have concerns about your health, sleep or mental wellbeing, seek professional help.</p>
				<h3>Accuracy and corrections</h3>
				<p>We try to be accurate, but we make no warranty that the content is complete or current. Some articles are older and are being reviewed. To report a mistake, see our <a href="/contact">contact page</a>.</p>
				<h3>How content is made</h3>
				<p>Articles are written with the help of AI tools and reviewed by a person. See our <a href="/about-us">About page</a> for details.</p>
				<h3>Copyright</h3>
				<p>All original content on this site is owned by its operator. You may quote short excerpts with a link back to the source article. Please do not republish full articles without permission.</p>
				<h3>External links</h3>
				<p>Articles may link to external websites. We are not responsible for the content or practices of those sites.</p>
				<h3>Advertising</h3>
				<p>This site may display advertising, including Google AdSense. See our <a href="/privacy-policy">Privacy Policy</a> for how advertising cookies are handled.</p>
				<h3>Changes</h3>
				<p>We may update these terms from time to time. Last updated: October 15, 2026.</p>
			</section>
		</main>
		<Footer />
	</body>
</html>